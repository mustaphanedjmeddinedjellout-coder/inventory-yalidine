# Server Environment Variables
PORT=5000
NODE_ENV=production
DB_PATH=./data/inventory.db
UPLOAD_DIR=./uploads

# Turso (libsql) connection (optional)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=replace_with_turso_token

# Yalidine Delivery API
YALIDINE_API_ID=your_api_id_here
YALIDINE_API_TOKEN=your_api_token_here
YALIDINE_FROM_WILAYA=Alger

# TikTok Events API
TIKTOK_PIXEL_ID=your_tiktok_pixel_id
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_TEST_EVENT_CODE=

# Meta (Facebook) Conversions API
# Pixel ID must match META_PIXEL_ID in client/src/App.jsx
META_PIXEL_ID=2159470911562696
META_ACCESS_TOKEN=your_meta_capi_access_token
META_API_VERSION=v22.0
# Set only while testing in Events Manager > Test events, then remove
META_TEST_EVENT_CODE=
